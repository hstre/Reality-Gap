<!-- ── Chart.js ─────────────────────────────────────────────────────────────── -->
<script>
  function initMacroChartDE(): void {
    const canvas = document.getElementById('macro-cape-chart-de') as HTMLCanvasElement | null;
    if (!canvas) return;
    if ((canvas as any).__macroChartInit) return;
    (canvas as any).__macroChartInit = true;

    // @ts-ignore
    const Chart = (window as any).Chart;
    if (!Chart) return;

    const raw = canvas.getAttribute('data-chart');
    if (!raw) return;
    const avg = parseFloat(canvas.getAttribute('data-avg') ?? '0');

    const { labels, rg10, avg: avgLine, gs10, corr } = JSON.parse(raw) as {
      labels: string[];
      rg10: number[];
      avg: number[];
      gs10: (number | null)[];
      corr: (number | null)[];
    };

    const refLine = labels.map(() => 1.0);

    new Chart(canvas, {
      type: 'line',
      data: {
        labels,
        datasets: [
          {
            label: 'M(S&P500)RG10',
            data: rg10,
            borderColor: '#1e4d78',
            backgroundColor: 'rgba(30,77,120,0.05)',
            fill: true,
            borderWidth: 2,
            pointRadius: 0,
            pointHoverRadius: 4,
            tension: 0.2,
            spanGaps: false,
            yAxisID: 'y',
            order: 1,
          },
          {
            label: `Langfr. Mittelwert (${avg.toFixed(2)}×)`,
            data: avgLine,
            borderColor: '#9ca3af',
            backgroundColor: 'transparent',
            borderWidth: 1.5,
            borderDash: [5, 4],
            pointRadius: 0,
            tension: 0,
            spanGaps: true,
            yAxisID: 'y',
            order: 2,
          },
          {
            label: 'RG10 = 1,0',
            data: refLine,
            borderColor: '#ef4444',
            backgroundColor: 'transparent',
            borderWidth: 1,
            borderDash: [2, 3],
            pointRadius: 0,
            tension: 0,
            spanGaps: true,
            yAxisID: 'y',
            order: 3,
          },
          {
            label: '10-J. Treasury (GS10)',
            data: gs10,
            borderColor: '#10b981',
            backgroundColor: 'transparent',
            borderWidth: 1.5,
            borderDash: [3, 2],
            pointRadius: 0,
            tension: 0.2,
            spanGaps: false,
            yAxisID: 'y2',
            order: 4,
          },
          {
            label: 'TE-korrigierter RG10 (jährlich, ab 1999)',
            data: corr ?? [],
            borderColor: '#059669',
            backgroundColor: 'transparent',
            borderWidth: 1.5,
            borderDash: [6, 3],
            pointRadius: 2,
            pointHoverRadius: 4,
            tension: 0.2,
            spanGaps: true,
            order: 0,
          },
        ],
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        animation: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: (ctx: any): string => {
                const v = ctx.parsed.y;
                if (v === null || v === undefined) return '';
                if (ctx.datasetIndex === 3) return `GS10: ${Number(v).toFixed(2)} %`;
                return `${ctx.dataset.label}: ${Number(v).toFixed(2)}×`;
              },
            },
          },
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: { color: '#9ca3af', font: { size: 10 }, maxRotation: 0, autoSkip: true, maxTicksLimit: 15 },
            border: { color: '#e5e7eb' },
          },
          y: {
            beginAtZero: true, min: 0, position: 'left',
            grid: { color: '#f3f4f6' },
            ticks: { color: '#9ca3af', font: { size: 10 }, callback: (v: any): string => `${Number(v).toFixed(1)}×` },
            border: { color: '#e5e7eb' },
          },
          y2: {
            beginAtZero: true, min: 0, max: 20, position: 'right',
            grid: { display: false },
            ticks: { color: '#10b981', font: { size: 9 }, callback: (v: any): string => `${Number(v).toFixed(0)}%` },
            border: { color: '#d1fae5' },
          },
        },
      },
    });
  }

  function loadChartJs(cb: () => void): void {
    // @ts-ignore
    if ((window as any).Chart) { cb(); return; }
    const s = document.createElement('script');
    s.src = 'https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js';
    s.onload = cb;
    s.onerror = (): void => console.warn('MacroChart: failed to load Chart.js');
    document.head.appendChild(s);
  }

  loadChartJs(initMacroChartDE);
</script>

</BaseLayout>
