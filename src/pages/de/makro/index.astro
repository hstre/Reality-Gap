---
import BaseLayout from '../../../components/layout/BaseLayout.astro';
import capeRaw from '../../../data/macro/sp500_cape.json';
import daxRaw  from '../../../data/macro/dax40_pe.json';
import macroRgRaw from '../../../data/macro/macro_rg.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const dax = (daxRaw as any).current as { date: string; rg10: number; trailing_pe: number };

// ── Types ────────────────────────────────────────────────────────────────────
interface CapePoint { date: string; cape: number; rg10: number; }
interface CapeData {
  source: string; url: string; fetched: string; note: string;
  sources: string[];
  yale_cutoff: string;
  supplement_url: string | null;
  series_standard: string;
  long_run_avg_rg10: number;
  long_run_max_rg10: number;
  long_run_min_rg10: number;
  current: { date: string; cape: number; rg10: number; trend: string; };
  series: CapePoint[];
  peaks: Array<{ date: string; note: string; cape?: number; rg10?: number; }>;
}

const data = capeRaw as unknown as CapeData;

// ── Aktueller Wert — letzte monatliche Beobachtung ───────────────────────────
const cur     = data.current;
const rg10    = cur.rg10;
const trend   = cur.trend;
const display = `${rg10.toFixed(2)}${trend}`;

// ── Langfristiger Durchschnitt (aus JSON) ────────────────────────────────────
const avgRg10 = data.long_run_avg_rg10;
const maxRg10 = data.long_run_max_rg10;
const minRg10 = data.long_run_min_rg10;

// ── Interpretation ───────────────────────────────────────────────────────────
function bandFor(v: number): { label: string; color: string; bg: string; border: string; } {
  if (v < 1.0) return { label: 'Unter dem langfristigen Durchschnitt — historisch selten',
                         color: 'text-emerald-700', bg: 'bg-emerald-50', border: 'border-emerald-200' };
  if (v < 1.8) return { label: 'Um den langfristigen Durchschnitt (~1,7) — normale Zone',
                         color: 'text-blue-700',    bg: 'bg-blue-50',    border: 'border-blue-200' };
  if (v < 2.5) return { label: 'Über dem Durchschnitt — erhöhte Vorsicht',
                         color: 'text-amber-700',   bg: 'bg-amber-50',   border: 'border-amber-200' };
  if (v < 3.5) return { label: 'Deutlich gestreckt — historisch erhöht',
                         color: 'text-orange-700',  bg: 'bg-orange-50',  border: 'border-orange-200' };
  return              { label: 'Historisch sehr heiß — seltenes Terrain',
                         color: 'text-red-700',     bg: 'bg-red-50',     border: 'border-red-200' };
}
const band = bandFor(rg10);

// ── Bandtabelle ──────────────────────────────────────────────────────────────
const bands = [
  { lo: 0,   hi: 1.0, rg: '< 1.0',   cape: '< 10',  label: 'Unter langfr. Durchschnitt / historisch attraktiv', color: 'bg-emerald-50 text-emerald-700 border-emerald-200', ctx: 'Selten außerhalb großer Bärenmärkte. 1982, 2009 kurzzeitig.' },
  { lo: 1.0, hi: 1.8, rg: '1,0–1,8', cape: '10–18', label: 'Um den langfristigen Durchschnitt — normale Zone',  color: 'bg-blue-50 text-blue-700 border-blue-200',           ctx: 'Langfristiger CAPE-Mittelwert ~17. Typisch in Erholungsphasen.' },
  { lo: 1.8, hi: 2.5, rg: '1,8–2,5', cape: '18–25', label: 'Über dem Durchschnitt — Vorsicht',                  color: 'bg-amber-50 text-amber-700 border-amber-200',         ctx: 'Häufig in anhaltenden Bullenmärkten (1960er, 1990er, 2010er).' },
  { lo: 2.5, hi: 3.5, rg: '2,5–3,5', cape: '25–35', label: 'Deutlich gestreckt — erhöhtes Risiko',              color: 'bg-orange-50 text-orange-700 border-orange-200',      ctx: 'Vor der GFC 2007 (~2,7), post-COVID 2021 (~3,9).' },
  { lo: 3.5, hi: 999, rg: '≥ 3,5',   cape: '≥ 35',  label: 'Historisch sehr heiß — seltenes Terrain',           color: 'bg-red-50 text-red-700 border-red-200',               ctx: 'Dotcom-Gipfel 2000 (~4,4), Ende 2021 (~3,9), heute (~3,9).' },
];
const currentBandIdx = bands.findIndex(b => rg10 >= b.lo && rg10 < b.hi);

// ── Monatsserie für Chart — selber Standard wie aktueller Wert ───────────────
const chartLabels = data.series.map(p => p.date);
const chartRg10   = data.series.map(p => p.rg10);
const chartAvg    = data.series.map(() => parseFloat(avgRg10.toFixed(3)));
const chartGs10   = data.series.map((p: any) => p.gs10 ?? null);

// ── TE-korrigierter Makro-RG (macro_rg.json) ─────────────────────────────────
const macroRg = macroRgRaw as any;
const mrIdx   = macroRg.indices ?? {};
const mrOrder = ['sp500', 'dax40', 'n225', 'hsi'];
const mrRows  = mrOrder
  .map(k => ({ key: k, ...(mrIdx[k] ?? {}) }))
  .filter((r: any) => r.topDown || r.bottomUp);
const spCorrected = mrIdx.sp500?.topDown?.rg10 ?? null;

// Korrigierte S&P-500-Serie (Jahresend-Punkte) auf Monats-Labels abgebildet
const corrMap = new Map<string, number>(
  ((mrIdx.sp500?.series ?? []) as any[]).map((p: any) => [p.date, p.rg10])
);
const chartCorr = data.series.map(p => corrMap.get(p.date) ?? null);

// Korrigierter aktueller Wert: Trend vs. letzter Jahresend-Punkt, Lage in eigener Historie
const corrSeries   = (mrIdx.sp500?.series ?? []) as any[];
const corrPrev     = corrSeries.length ? corrSeries[corrSeries.length - 1].rg10 : null;
const corrTrendPct = (spCorrected != null && corrPrev) ? ((spCorrected - corrPrev) / corrPrev) * 100 : null;
const corrTrend    = corrTrendPct == null ? ''
  : corrTrendPct > 20 ? '++' : corrTrendPct > 5 ? '+' : corrTrendPct >= -5 ? '=' : corrTrendPct >= -20 ? '-' : '--';
const corrMax      = corrSeries.length ? Math.max(...corrSeries.map((p: any) => p.rg10)) : null;
const corrIsRecord = spCorrected != null && corrMax != null && spCorrected >= corrMax;
const corrFirst    = corrSeries.length ? corrSeries[0] : null;   // 1999-12 Dotcom-Jahresende
// Die CAPE-kalibrierten Bänder gelten NICHT für die korrigierte Kennzahl
// (gestauchte Skala). Einordnung stattdessen per Perzentil in eigener Serie.
const corrVals = corrSeries.map((p: any) => p.rg10 as number);
const corrPct  = (spCorrected != null && corrVals.length)
  ? Math.round((corrVals.filter(v => v < spCorrected).length / corrVals.length) * 100)
  : null;
function corrBandFor(pct: number): { label: string; color: string; bg: string; border: string; } {
  if (pct >= 95) return { label: 'Rekordterrain — über jedem Jahresendwert seit 1999, inkl. Dotcom',
                          color: 'text-red-700',     bg: 'bg-red-50',     border: 'border-red-200' };
  if (pct >= 80) return { label: 'Oberes Extrem der korrigierten Serie (oberstes Quintil)',
                          color: 'text-orange-700',  bg: 'bg-orange-50',  border: 'border-orange-200' };
  if (pct >= 60) return { label: 'Über dem Median der korrigierten Serie',
                          color: 'text-amber-700',   bg: 'bg-amber-50',   border: 'border-amber-200' };
  if (pct >= 40) return { label: 'Um den Median der korrigierten Serie',
                          color: 'text-blue-700',    bg: 'bg-blue-50',    border: 'border-blue-200' };
  return              { label: 'Unterer Bereich der korrigierten Serie',
                          color: 'text-emerald-700', bg: 'bg-emerald-50', border: 'border-emerald-200' };
}
const corrBand = corrPct != null ? corrBandFor(corrPct) : band;
// Referenzpunkte der korrigierten Serie (für den Referenzblock in §3)
const corrMinP   = corrSeries.length ? corrSeries.reduce((a: any, b: any) => (b.rg10 < a.rg10 ? b : a)) : null;
const corrMedian = corrVals.length ? [...corrVals].sort((a, b) => a - b)[Math.floor(corrVals.length / 2)] : null;
const corr2021   = corrSeries.find((p: any) => p.date === '2021-12') ?? null;

const chartData = JSON.stringify({ labels: chartLabels, rg10: chartRg10, avg: chartAvg, gs10: chartGs10, corr: chartCorr });

const hasMultpl = data.sources.includes('multpl_supplement');

function fmt2(v: number): string { return v.toFixed(2); }
---

<BaseLayout
  title="Makro-RG — Reality Gap"
  description="M(S&P500)RG10: Makro-Näherung des Reality Gap auf Basis des Shiller/CAPE-Datensatzes. Historische Zeitreihe 1881 bis heute."
  lang="de"
  canonicalPath="/de/makro"
  altLangPath="/macro"
  altLang="en"
>
<div class="max-w-5xl mx-auto px-6 py-12">

  <!-- ── Header ──────────────────────────────────────────────────────────── -->
  <div class="mb-2">
    <a href={`${base}/de/`} class="text-sm text-gray-400 hover:text-accent no-underline">← Startseite</a>
  </div>

  <!-- Index-Umschalter -->
  <div class="flex items-center gap-2 mb-4 flex-wrap">
    <span class="text-xs border border-accent bg-accent/5 text-accent rounded px-3 py-1 font-medium">
      S&amp;P 500 ←
    </span>
    <a href={`${base}/de/makro/dax40`}
       class="text-xs border border-gray-200 rounded px-3 py-1 text-gray-500 hover:text-accent hover:border-accent no-underline transition-colors">
      DAX 40
    </a>
    <a href={`${base}/de/makro/global`}
       class="text-xs border border-gray-200 rounded px-3 py-1 text-gray-500 hover:text-accent hover:border-accent no-underline transition-colors">
      Globaler Buffett-Indikator
    </a>
    <a href={`${base}/de/makro/korrelation`}
       class="text-xs border border-gray-200 rounded px-3 py-1 text-gray-500 hover:text-accent hover:border-accent no-underline transition-colors">
      Korrelation
    </a>
  </div>

  <h1 class="text-3xl font-normal text-gray-900 mb-2" style="font-family: Georgia, serif;">
    Makro-RG — Marktweite Näherung
  </h1>
  <p class="text-gray-600 mb-1">
    Eine Makro-Erweiterung des Reality-Gap-Rahmens: Der RG-Blick richtet sich
    auf ganze Aktienuniversen statt auf einzelne Unternehmen.
  </p>
  <div class="flex flex-wrap gap-2 mb-8">
    <span class="text-xs bg-blue-50 text-blue-700 border border-blue-200 rounded px-2 py-0.5">Makro-Näherung — kein vollständiger RG</span>
    <span class="text-xs bg-gray-50 text-gray-500 border border-gray-200 rounded px-2 py-0.5">Monatliche Reihe · {data.series.length} Beobachtungen</span>
    <span class="text-xs bg-gray-50 text-gray-500 border border-gray-200 rounded px-2 py-0.5">Daten bis {cur.date} · abgerufen {data.fetched}</span>
    <span class="text-xs bg-amber-50 text-amber-700 border border-amber-200 rounded px-2 py-0.5">CAPE-Serie nur Ertragsseite — TE-korrigierte Variante in §2</span>
  </div>

  <!-- ── Abschnitt 1: Aktueller Wert ────────────────────────────────────── -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold text-gray-800 mb-4" style="font-family: Georgia, serif;">
      1. Aktueller Wert
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
      <!-- Hauptkennzahl: TE-korrigiert -->
      <div class={`border rounded-md p-5 ${corrBand.bg} ${corrBand.border}`}>
        <div class="text-xs text-gray-500 mb-1 font-medium tracking-wide uppercase">M(S&amp;P 500)RG10 · TE-korrigiert</div>
        <div class={`text-4xl font-mono font-semibold mb-1 ${corrBand.color}`}>{spCorrected?.toFixed(2)}<span class="text-2xl">{corrTrend}</span></div>
        <div class="text-xs text-gray-500">1/(1/KBV + 10/CAPE) · Stand: {macroRg.fetched}</div>
        <div class={`text-xs mt-2 font-medium ${corrBand.color}`}>{corrBand.label}</div>
        {corrIsRecord && corrFirst && (
          <div class="text-xs mt-1 text-gray-600">
            Höchster Punkt der korrigierten Serie (1999–heute) — über dem
            Dotcom-Jahresende {corrFirst.date} ({corrFirst.rg10.toFixed(2)}).
          </div>
        )}
      </div>

      <!-- Earnings-only als Obergrenze -->
      <div class="border border-gray-200 rounded-md p-5 bg-gray-50">
        <div class="text-xs text-gray-500 mb-1 font-medium tracking-wide uppercase">Earnings-only (Obergrenze)</div>
        <div class="text-3xl font-mono font-semibold text-gray-600 mb-1">{display}</div>
        <div class="text-xs text-gray-500">CAPE / 10 · Shiller CAPE {cur.cape.toFixed(1)} · {cur.date}</div>
        <div class="text-xs text-gray-400 mt-2">
          Ignoriert das materielle Eigenkapital. Der wahre Makro-RG liegt zwischen
          {spCorrected?.toFixed(2)} (korrigiert, Untergrenze) und {rg10.toFixed(2)}.
          Langfristiger CAPE-Mittelwert: ~{(avgRg10 * 10).toFixed(1)}.
        </div>
      </div>

      <!-- Formel -->
      <div class="border border-gray-200 rounded-md p-5 bg-white">
        <div class="text-xs text-gray-500 mb-2 font-medium tracking-wide uppercase">Konstruktion</div>
        <div class="font-mono text-sm text-gray-800 mb-1">Veröffentlicht: 1 / (1/KBV + 10/CAPE)</div>
        <div class="font-mono text-xs text-gray-500 mb-3">Obergrenze (historische Serie): CAPE / 10</div>
        <p class="text-xs text-gray-500">
          Der vollständige Makro-RG lautet <span class="font-mono">MC / (Buchwert + 10·Gewinne)</span>.
          Da <span class="font-mono">Buchwert = MC/PB</span> und <span class="font-mono">Gewinne = MC/CAPE</span>,
          vereinfacht sich das zu <span class="font-mono">1/(1/PB + 10/CAPE)</span>.
          Die TE-korrigierte Konstruktion wird in Abschnitt 2 veröffentlicht (KBV via multpl.com);
          CAPE/10 bleibt die historische Serie — sie liegt immer über der vollständigen Konstruktion.
        </p>
      </div>
    </div>

    <!-- Trendzeichen -->
    <div class="text-sm text-gray-600 border-l-2 border-gray-200 pl-4">
      Trendzeichen: korrigierter Wert vs. letzter Jahresend-Punkt der korrigierten Serie; Earnings-only-Wert vs. 12 Monate zuvor.
      <span class="font-mono text-gray-700 ml-1">++ &gt;+20% · + &gt;+5% · = ±5% · - &gt;−5% · -- &gt;−20%</span>
    </div>
  </section>

  <!-- ── Abschnitt 2: TE-korrigierter Makro-RG ──────────────────────────── -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold text-gray-800 mb-1" style="font-family: Georgia, serif;">
      2. Die fehlende Hälfte — TE-korrigierter Makro-RG
    </h2>
    <p class="text-sm text-gray-500 mb-4">
      Der RG auf Unternehmensebene teilt die Marktkapitalisierung durch die
      <em>vollständige</em> Fundamentalbasis TE + N·G. CAPE / 10 erfasst nur die
      Ertragshälfte — das materielle Eigenkapital fehlt im Nenner, der CAPE-basierte
      Wert ist daher eine systematische <strong>Obergrenze</strong>. Die fehlende
      Hälfte lässt sich über das Kurs-Buchwert-Verhältnis des Index exakt herleiten:
    </p>

    <div class="border border-gray-200 rounded-md p-5 bg-gray-50 mb-6">
      <div class="text-xs text-gray-500 mb-2 font-medium tracking-wide uppercase">Identität</div>
      <div class="font-mono text-sm text-gray-800 mb-2">
        1 / RG<sub>N</sub> = TE/MC + N·G/MC = 1/KBV + N/KGV<sub>geglättet</sub>
        &nbsp;&nbsp;⇒&nbsp;&nbsp; RG<sub>N</sub> = 1 / (1/KBV + N/KGV<sub>geglättet</sub>)
      </div>
      <p class="text-xs text-gray-500">
        KBV = Kurs-Buchwert-Verhältnis des Index, KGV<sub>geglättet</sub> = CAPE
        (S&amp;P 500) bzw. Trailing-Portfolio-KGV (übrige Indizes). Da das Index-KBV
        auf dem <em>Buchwert</em> basiert (inkl. Goodwill und Intangibles), nicht auf dem
        tangiblen Buchwert, ist der korrigierte Wert eine <strong>Untergrenze</strong> —
        der wahre Makro-RG liegt zwischen korrigiertem und Earnings-only-Wert.
      </p>
    </div>

    <div class="overflow-x-auto mb-4">
      <table class="table-rg w-full">
        <thead>
          <tr class="bg-gray-50">
            <th class="text-left text-xs text-gray-500 font-medium">Index</th>
            <th class="text-right text-xs text-gray-500 font-medium">Earnings-only RG10</th>
            <th class="text-right text-xs text-gray-500 font-medium">TE-korrigierter RG10</th>
            <th class="text-right text-xs text-gray-500 font-medium">Bottom-up ΣMC / Σ(TE+10·G)</th>
            <th class="text-right text-xs text-gray-500 font-medium">KBV</th>
            <th class="text-left text-xs text-gray-500 font-medium">Ertragsbasis</th>
          </tr>
        </thead>
        <tbody>
          {mrRows.map((r: any) => (
            <tr>
              <td class="text-sm font-medium text-gray-700 whitespace-nowrap">{r.label}</td>
              <td class="font-mono text-sm text-gray-500 text-right">{r.earningsOnly?.rg10?.toFixed(2) ?? '—'}</td>
              <td class="font-mono text-sm font-semibold text-gray-900 text-right">{r.topDown?.rg10?.toFixed(2) ?? '—'}</td>
              <td class="font-mono text-sm text-gray-700 text-right">
                {r.bottomUp?.rg10?.toFixed(2) ?? '—'}
                {r.bottomUp && <span class="text-xs text-gray-400 font-sans"> (n={r.bottomUp.n})</span>}
              </td>
              <td class="font-mono text-sm text-gray-600 text-right">{r.topDown?.pb?.toFixed(2) ?? '—'}</td>
              <td class="text-xs text-gray-500">{r.topDown?.peBasis ?? '—'}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="text-sm text-gray-600 border-l-2 border-gray-200 pl-4 mb-3">
      Zwei unabhängige Konstruktionen validieren sich gegenseitig: Beim S&amp;P 500 liegen
      der Top-down-korrigierte Wert ({spCorrected?.toFixed(2)}) und das Bottom-up-Aggregat
      über die {mrIdx.sp500?.bottomUp?.n} abgedeckten Unternehmen
      ({mrIdx.sp500?.bottomUp?.rg10?.toFixed(2)}) nah beieinander — weit unter dem
      Earnings-only-Wert von {mrIdx.sp500?.earningsOnly?.rg10?.toFixed(2)}.
    </div>
    <p class="text-xs text-gray-400">
      Bottom-up: wertgewichtetes ΣMC / Σ(TE + 10·G) über die in diesem Datensatz abgedeckten
      Konstituenten (exakte RG-Formel inkl. materiellem Eigenkapital; nur Teilabdeckung).
      Top-down-KBV-Quellen: multpl.com (S&amp;P 500), Portfolio-Kennzahlen replizierender ETFs via
      yfinance (DAX 40, Nikkei 225, Hang Seng). Ertragsbasis außerhalb der USA: Trailing-12M-KGV,
      kein CAPE. Tägliche Aktualisierung. Stand: {macroRg.fetched}.
    </p>
  </section>

  <!-- ── Abschnitt 3: Interpretationsbänder ─────────────────────────────── -->
  <section class="mb-12">
    <h2 class="text-xl font-semibold text-gray-800 mb-1" style="font-family: Georgia, serif;">
      3. Heuristische Interpretationsbänder
    </h2>
    <p class="text-sm text-gray-500 mb-5">
      Nur als Orientierungshilfe. Es handelt sich nicht um Kauf- oder Verkaufssignale —
      Märkte können über lange Zeiträume in jeder Zone verharren.
      <strong>Diese Bänder sind auf die Earnings-only-CAPE-Skala kalibriert und gelten
      nicht für die TE-korrigierte Kennzahl</strong>, die auf einer gestauchten Skala
      läuft — ihre eigenen Referenzpunkte stehen unter der Tabelle.
    </p>

    <div class="overflow-x-auto">
      <table class="table-rg w-full">
        <thead>
          <tr class="bg-gray-50">
            <th class="text-left text-xs text-gray-500 font-medium">M(S&amp;P 500)RG10</th>
            <th class="text-left text-xs text-gray-500 font-medium">CAPE-Äquivalent</th>
            <th class="text-left text-xs text-gray-500 font-medium">Heuristische Bezeichnung</th>
            <th class="text-left text-xs text-gray-500 font-medium">Kontext</th>
          </tr>
        </thead>
        <tbody>
          {bands.map((row, i) => (
            <tr class={i === currentBandIdx ? 'bg-blue-50/40' : ''}>
              <td class="font-mono font-semibold text-sm text-gray-800 whitespace-nowrap">
                {row.rg}
                {i === currentBandIdx && (
                  <span class={`ml-2 text-xs rounded px-1.5 py-0.5 border font-normal ${row.color}`}>← Earnings-only ({rg10.toFixed(2)})</span>
                )}
              </td>
              <td class="font-mono text-sm text-gray-600 whitespace-nowrap">{row.cape}</td>
              <td><span class={`text-xs rounded px-2 py-0.5 border font-medium ${row.color}`}>{row.label}</span></td>
              <td class="text-xs text-gray-500">{row.ctx}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  
    <!-- Referenzpunkte der korrigierten Serie -->
    <div class="mt-5 border border-gray-200 rounded-md bg-gray-50/50 px-4 py-3">
      <div class="text-xs text-gray-500 mb-2 font-medium tracking-wide uppercase">
        TE-korrigierte Serie — eigene Referenzpunkte (Jahresendwerte, 1999–heute)
      </div>
      <div class="flex flex-wrap gap-x-6 gap-y-1 text-sm font-mono">
        {corrMinP && <span class="text-emerald-700">{corrMinP.rg10.toFixed(2)} <span class="font-sans text-xs text-gray-500">Finanzkrisen-Tief ({corrMinP.date})</span></span>}
        {corrMedian != null && <span class="text-blue-700">{corrMedian.toFixed(2)} <span class="font-sans text-xs text-gray-500">Median</span></span>}
        {corr2021 && <span class="text-amber-700">{corr2021.rg10.toFixed(2)} <span class="font-sans text-xs text-gray-500">Post-COVID-Hoch (2021-12)</span></span>}
        {corrFirst && <span class="text-orange-700">{corrFirst.rg10.toFixed(2)} <span class="font-sans text-xs text-gray-500">Dotcom-Jahresende (1999-12)</span></span>}
        {spCorrected != null && <span class="text-red-700 font-semibold">{spCorrected.toFixed(2)} <span class="font-sans text-xs">aktuell — {corrPct}. Perzentil{corrIsRecord ? ', Rekord' : ''}</span></span>}
      </div>
      <p class="text-xs text-gray-500 mt-2">
        Auf der eigenen Skala liegt der korrigierte Wert <strong>nicht</strong> in einer
        moderaten Zone: Er steht über jedem Jahresendwert seit 1999, einschließlich des
        Dotcom-Jahresendes. Die gestauchte Skala (Buchkapital im Nenner dämpft die
        Ausschläge) macht das Querlesen gegen die CAPE-Bänder irreführend.
      </p>
    </div>
  </section>

  <!-- ── Abschnitt 4: Historischer Chart ────────────────────────────────── -->
